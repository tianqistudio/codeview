# Active source formatting; existing nested configurations take precedence.
root = true

[/{tools/sn-viewer/**.cs,tools/sn-viewer/**.py}]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[/{tools/sn-viewer/**.js,tools/sn-viewer/**.mjs,tools/sn-viewer/**.cjs,tools/sn-viewer/**.ts,tools/sn-viewer/**.tsx}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[/{README.md,README.en.md}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

[**/{bin,obj,dist,build,node_modules,vendor,__pycache__,.venv,.venv-worker,archive,Archived,archives,artifacts,releases,qa,generated}/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
